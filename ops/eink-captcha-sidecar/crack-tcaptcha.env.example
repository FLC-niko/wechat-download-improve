# Copy to /etc/crack-tcaptcha.env, replace the secret, then chmod 0600.
TCAPTCHA_SERVE_SK=REPLACE_WITH_A_RANDOM_SECRET
TCAPTCHA_SERVE_HOST=127.0.0.1
TCAPTCHA_SERVE_PORT=9991
TCAPTCHA_SERVE_WORKERS=1
TCAPTCHA_ORT_BACKEND=cpu
TCAPTCHA_ORT_INTRA_OP_THREADS=4

# Optional outbound proxy. Leave unset unless the approved E-Ink path requires it.
# TCAPTCHA_PROXY=http://user:pass@host:port

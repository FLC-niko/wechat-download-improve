# E-Ink browser solver daemon environment (server: /etc/eink-browser-solver.env)
# Copy this file to /etc/eink-browser-solver.env, fill in SOLVER_SK with the
# same secret as weread.eink.human_verify.auto_solver.secret in the app
# config.yaml, then: systemctl enable --now eink-browser-solver
SOLVER_PORT=9991
SOLVER_SK=REPLACE_WITH_THE_AUTO_SOLVER_SECRET
SOLVER_DEBUG_PORT=9333
CLIP_URL=http://127.0.0.1:9993/pick
CHROME_PATH=/opt/ms-playwright/chromium-1248/chrome-linux64/chrome
CHROME_PROFILE=/tmp/eink-solver-chrome
HEADLESS=0
CHROME_EXTRA_ARGS=--no-sandbox --disable-dev-shm-usage
SOLVER_MAX_ROUNDS=12
SOLVER_BUDGET_MS=70000
DEBUG_SAVE=0
DEBUG_DIR=/opt/eink-browser-solver/debug
DISPLAY=:99
SLOW_PACE=1
SOLVER_UA=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36
